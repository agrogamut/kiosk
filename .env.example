# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://madamgy:changeme@localhost:5432/madamgy

# better-auth
BETTER_AUTH_SECRET=replace-with-64-char-random-string
BETTER_AUTH_URL=https://yourdomain.com/api

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# LiveKit — port 7880 required (clients bypass Caddy, connect directly)
LIVEKIT_HOST=wss://yourdomain.com:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# CORS — must match where the web app is served from
WEB_URL=https://yourdomain.com

# ── Web (Next.js — must prefix NEXT_PUBLIC_) ─────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_SOCKET_URL=https://yourdomain.com
NEXT_PUBLIC_LIVEKIT_URL=wss://yourdomain.com:7880
