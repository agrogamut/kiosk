# TEMPLATE FILE — do not deploy with these values.
# Run `fish scripts/generate-secrets.fish` to create a real .env with random JWT secrets,
# then fill in MINIO_*, LIVEKIT_*, MSG91_*, RAZORPAY_*, ADMIN_PASSWORD yourself.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://madamgy:madamgy@localhost:55432/madamgy
REDIS_URL=redis://localhost:56379

# Separate database/redis-db so `npm test` never touches dev data -- run
# scripts/create-test-db.fish once to set this up. vitest.config.ts falls back to
# DATABASE_URL/REDIS_URL if these are unset, so tests still run -- just unsafely.
TEST_DATABASE_URL=postgresql://madamgy:madamgy@localhost:55432/madamgy_test
TEST_REDIS_URL=redis://localhost:56379/1

JWT_ACCESS_SECRET=replace-with-64-char-random-string-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=replace-with-64-char-random-string-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

LIVEKIT_API_KEY=devkey
# Must match the secret under `keys:` in livekit/livekit.yaml, and be 32+ characters --
# livekit-server refuses to start otherwise. Generate one with: openssl rand -hex 24
LIVEKIT_API_SECRET=replace-with-a-generated-32-plus-character-secret

MINIO_ENDPOINT=localhost
MINIO_PORT=19000
MINIO_ACCESS_KEY=madamgy
MINIO_SECRET_KEY=madamgy123
MINIO_BUCKET=madamgy
MINIO_USE_SSL=false
MINIO_SKIP_BUCKET_CHECK=false

MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=MADAMG
MSG91_TEMPLATE_ID=your-otp-template-id

# CONSULTATION_FEE only seeds the initial RevenueConfig row (see prisma/seed.ts).
# After first seed, the live fee is whatever SUPER_ADMIN set via PUT /api/admin/revenue-config.
CONSULTATION_FEE=200
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=admin123

RAZORPAY_KEY_ID=your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
REQUIRE_PAYMENT_FOR_CALLS=false

# set to true only after the frontend plan's doctor-heartbeat task has shipped — otherwise every ACTIVE call gets ended after ~45s with no heartbeat ever recorded
STALE_CALL_REAPER_ENABLED=false

WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
VITE_LIVEKIT_URL=ws://localhost:7880
