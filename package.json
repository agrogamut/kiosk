{
  "name": "madamgy",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "packages/api-client",
    "packages/server",
    "packages/web",
    "packages/kiosk-android"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @madamgy/server & npm run dev --workspace @madamgy/web & wait",
    "dev:server": "fish scripts/dev-server.fish",
    "dev:ready": "fish scripts/dev-server.fish --web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @madamgy/server"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  }
}
